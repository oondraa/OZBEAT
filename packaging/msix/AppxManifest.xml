<?xml version="1.0" encoding="utf-8"?>
<!-- Template: build.ps1 fills in the {{...}} values. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IdentityName}}"
    Publisher="{{Publisher}}"
    Version="{{Version}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>OZBEAT</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Music visualizer: cover art, synced lyrics and smooth visuals for whatever is playing.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="cs-cz" />
  </Resources>

  <Applications>
    <Application Id="OZBEAT" Executable="OZBEAT.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OZBEAT"
        Description="Music visualizer with synced lyrics"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#111111" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Lyrics, covers and videos from the internet. -->
    <Capability Name="internetClient" />
    <!-- BluOS speakers and WLED lights on the home network. -->
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Microphone mode, for music from speakers this PC does not play. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
